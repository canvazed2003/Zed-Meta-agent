# Local development and testing settings.
#   cp .env.example .env && chmod 600 .env
# Railway does not use this file: set Variables with the same names in the service instead.
# Comments must stay on their own lines (python-dotenv misreads `KEY=   # comment`).

# Bot token from @BotFather (/newbot). Enable Bot Settings -> Business Mode for the bot.
TELEGRAM_BOT_TOKEN=

# Your own numeric Telegram user id (ask @userinfobot). Only this account's business connection is served.
OWNER_ID=

# false = PREVIEW: replies are only shown in the logs and data/previews.jsonl, nothing is sent.
# true = AUTO-SEND: replies are sent to the chats on your behalf.
AUTO_SEND=false

# Claude subscription token: the sk-ant-oat... value printed by `claude setup-token`.
# Create it once on a computer with a browser; it is valid for 1 year.
# Keep it like a password. Paste it with an editor, on ONE line (not with `echo ... >> .env`).
# Leave empty to use this machine's own `claude` login (local testing only).
# Never put an Anthropic API key (sk-ant-api...) here.
CLAUDE_CODE_OAUTH_TOKEN=

# Path to the claude CLI. Empty = `claude` from PATH, then ~/.local/bin/claude.
CLAUDE_BIN=

# Model alias or full name (for example sonnet or opus). Empty = the CLI default.
CLAUDE_MODEL=

# Thinking effort: low, medium, high, xhigh or max. Lower is faster and uses less of the subscription.
CLAUDE_EFFORT=low

# Seconds to wait for one reply before giving up (minimum 1).
CLAUDE_TIMEOUT_SECONDS=120

# When the subscription limit is hit and Claude gives no reset time, wait this many minutes (minimum 1).
LIMIT_COOLDOWN_MINUTES=30

# After you write in a chat yourself, the bot stays quiet in that chat for this many minutes (0 = off).
OWNER_TAKEOVER_MINUTES=15

# How many recent messages per chat are kept and given to Claude (minimum 1).
HISTORY_LIMIT=30
